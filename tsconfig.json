{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./output",

    "module": "ES2020",
    "target": "es6",
    "types": ["node"],

    "sourceMap": false,
    "declaration": true,
    "declarationMap": true,

    "strict": false,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}